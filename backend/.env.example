# ==========================================
# Volunteer Platform — Backend Environment
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ==========================================

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/volunteer_platform

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-long-random-secret-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-long-random-secret-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- MFA ---
# Issuer name shown in authenticator apps (e.g. Google Authenticator, Authy).
# Reads from MFA_ISSUER_NAME, then APP_NAME, then MFA_APP_NAME (legacy), then defaults to "VolunteerPlatform".
MFA_ISSUER_NAME=VolunteerPlatform
MFA_APP_NAME=VolunteerPlatform

# --- Organization ---
# Default org ID for single-org deployment
DEFAULT_ORG_ID=org_replace_with_uuid_after_seed

# --- Rate Limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Stricter limits for auth endpoints
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173

# --- Cookie ---
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# --- Logging ---
LOG_LEVEL=debug
